[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
CatalogFile=switchjoycon.cat
DriverVer=11/18/2026,0.3.20.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTarm64

[Models.NTarm64]
%RightDevice%=Right,ACPI\SWOA0E01
%LeftDevice%=Left,ACPI\SWOA0E02

[Right.NT]
CopyFiles=DriverFiles

[Left.NT]
CopyFiles=DriverFiles

[Right.NT.HW]
AddReg=Hardware

[Left.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,LowerFilters,0x00010000,"vhf"
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[Right.NT.Services]
AddService=switchjoycon,0x00000002,Service

[Left.NT.Services]
AddService=switchjoycon,0x00000002,Service

[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\switchjoycon.sys

[Right.NT.Wdf]
KmdfService=switchjoycon,Framework

[Left.NT.Wdf]
KmdfService=switchjoycon,Framework

[Framework]
KmdfLibraryVersion=1.15

[DestinationDirs]
DriverFiles=13

[DriverFiles]
switchjoycon.sys

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
switchjoycon.sys=1

[Strings]
Provider="SwitchWOA"
ServiceName="Switch Joy-Con Rail Gamepad"
RightDevice="Switch Joy-Con (Right, rail UART-B)"
LeftDevice="Switch Joy-Con (Left, rail UART-C)"
Disk="Switch Joy-Con Rail Driver"
