diff --git a/Drivers/WifiBtApp/WifiLog.h b/Drivers/WifiBtApp/WifiLog.h
new file mode 100644
index 0000000..d3e1c54
--- /dev/null
+++ b/Drivers/WifiBtApp/WifiLog.h
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Checkpoint log for the Wi-Fi preparation path.
+ *
+ * The firmware's exception handler can only draw a register dump on the panel
+ * and halt, which a photograph cannot resolve into a call site. This writes the
+ * progress of each step to \SwitchWOA\Wifi\wifiprep.log on the first volume
+ * that accepts it, flushing after every line: whatever the last line is, that
+ * is the step that killed the machine.
+ *
+ * Include before WifiPexStages.h (PexChip logs its sub-steps) and it is also
+ * visible to WifiPrepare.h, which is included later in the same translation
+ * unit.
+ */
+#ifndef WIFI_LOG_H
+#define WIFI_LOG_H
+
+STATIC EFI_FILE_PROTOCOL *mWifiLogFile = NULL;
+STATIC BOOLEAN            mWifiLogTried = FALSE;
+
+/* Not STATIC-only for readability: this file is included once. */
+STATIC VOID
+WifiLogOpen (
+  VOID
+  )
+{
+  EFI_HANDLE                        *Handles = NULL;
+  UINTN                              Count = 0;
+  UINTN                              Index;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL   *Fs;
+  EFI_FILE_PROTOCOL                 *Root;
+  EFI_FILE_PROTOCOL                 *File;
+
+  if (mWifiLogTried) return;
+  mWifiLogTried = TRUE;
+
+  if (EFI_ERROR (gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid,
+                                          NULL, &Count, &Handles))) {
+    return;
+  }
+
+  for (Index = 0; Index < Count; Index++) {
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiSimpleFileSystemProtocolGuid,
+                                        (VOID **)&Fs))) continue;
+    if (EFI_ERROR (Fs->OpenVolume (Fs, &Root))) continue;
+    if (!EFI_ERROR (Root->Open (Root, &File, L"\\SwitchWOA\\Wifi\\wifiprep.log",
+                                EFI_FILE_MODE_CREATE | EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0))) {
+      mWifiLogFile = File;
+      /* EFI_FILE_PROTOCOL::SetPosition with MAX_UINT64 seeks to end of file. */
+      File->SetPosition (File, 0xFFFFFFFFFFFFFFFFULL);
+      break;
+    }
+    Root->Close (Root);
+  }
+  gBS->FreePool (Handles);
+}
+
+STATIC VOID
+WifiLogF (
+  IN CONST CHAR8  *Format,
+  ...
+  )
+{
+  VA_LIST  Marker;
+  CHAR8    Buffer[200];
+  UINTN    Length;
+
+  VA_START (Marker, Format);
+  Length = AsciiVSPrint (Buffer, sizeof (Buffer) - 3, Format, Marker);
+  VA_END (Marker);
+
+  if (!mWifiLogTried) WifiLogOpen ();
+  if (mWifiLogFile == NULL) return;
+
+  if (Length > sizeof (Buffer) - 3) Length = sizeof (Buffer) - 3;
+  Buffer[Length++] = '\r';
+  Buffer[Length++] = '\n';
+  mWifiLogFile->Write (mWifiLogFile, &Length, Buffer);
+  mWifiLogFile->Flush (mWifiLogFile);
+}
+
+
+
+#endif
diff --git a/Drivers/WifiBtApp/WifiPcie.h b/Drivers/WifiBtApp/WifiPcie.h
index cacbedb..300addc 100644
--- a/Drivers/WifiBtApp/WifiPcie.h
+++ b/Drivers/WifiBtApp/WifiPcie.h
@@ -483,6 +483,8 @@ PexCfgRd (
   )
 {
   UINT32  Off;
+  UINT32  V;
+  UINTN   Try;
 
   if (Bus == 0) {
     if (Dev != (PEX_PORT + 1U) || Fn != 0) {
@@ -491,9 +493,23 @@ PexCfgRd (
     return Rd (PEX_RP_BASE + PEX_PORT * 0x1000, Where & 0xFFC);
   }
   Off = ((Where & 0xF00U) << 16) | (Bus << 16) | (Dev << 11) | (Fn << 8) | (Where & 0xFF);
-  Wr (PEX_AFI, AFI_FPCI_BAR0, 0xFE100000U + ((Off & ~0xFFFU) >> 8));
-  (VOID)Rd (PEX_AFI, AFI_FPCI_BAR0);
-  return Rd (PEX_CS, Off & 0xFFC);
+  // The FPCI window needs a settle cycle between the BAR0 arm write and the
+  // config read: back-to-back reads can come back 0xFFFFFFFF even though the
+  // endpoint answered the previous one (observed on Erista: alternating
+  // 0xFFFFFFFF / real data in one dump). Retry a few times before believing
+  // "unsupported request".
+  V = 0xFFFFFFFF;
+  for (Try = 0; Try < 3; Try++) {
+    Wr (PEX_AFI, AFI_FPCI_BAR0, 0xFE100000U + ((Off & ~0xFFFU) >> 8));
+    (VOID)Rd (PEX_AFI, AFI_FPCI_BAR0);
+    Us (1);
+    V = Rd (PEX_CS, Off & 0xFFC);
+    if (V != 0xFFFFFFFF) {
+      break;
+    }
+    Us (10);
+  }
+  return V;
 }
 
 STATIC
@@ -517,6 +533,7 @@ PexCfgWr (
   Off = ((Where & 0xF00U) << 16) | (Bus << 16) | (Dev << 11) | (Fn << 8) | (Where & 0xFF);
   Wr (PEX_AFI, AFI_FPCI_BAR0, 0xFE100000U + ((Off & ~0xFFFU) >> 8));
   (VOID)Rd (PEX_AFI, AFI_FPCI_BAR0);
+  Us (1);
   Wr (PEX_CS, Off & 0xFFC, V);
 }
 
